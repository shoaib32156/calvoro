{
  "name": "calvoro",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "kv_namespaces": [
    {
      "binding": "TEMP_MAIL_KV",
      "id": "d8e6641b487d428ba665f5f4a244daf4"
    }
  ],
  "ratelimits": [
    {
      "name": "METADATA_RATE_LIMITER",
      "namespace_id": "20261024",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api", "/api/*"]
  }
}